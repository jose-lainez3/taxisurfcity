{
  "name": "taxisurfcity",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-27",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/",
      "/index",
      "/index.html",
      "/tours",
      "/tours/",
      "/tours.html",
      "/aeropuerto",
      "/aeropuerto/",
      "/aeropuerto.html",
      "/api/*",
      "/functions/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
